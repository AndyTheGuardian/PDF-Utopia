<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PdfUtopia.App.ViewModels"
        xmlns:views="using:PdfUtopia.App.Views"
        xmlns:controls="using:PdfUtopia.App.Controls"
        xmlns:settings="using:PdfUtopia.Core.Settings"
        xmlns:loc="using:PdfUtopia.App.Localization"
        x:Class="PdfUtopia.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PDF Utopia"
        Width="1280" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExtractCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding InsertPagesCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding InsertBlankPageCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Border.bar">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.thumb">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Border.thumb.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <!-- Mehrfachauswahl (A48): Rahmen in der Akzentfarbe; die angezeigte Seite ist zusätzlich hinterlegt -->
    <!-- Strg gedrückt: Drehen-Symbol gespiegelt (gegen den Uhrzeigersinn) -->
    <!-- Spiegelung um die Mitte mit derselben Verkleinerung wie Path.icon bzw. Path.icon.small (App.axaml),
         damit gespiegeltes und normales Symbol exakt gleich groß sind -->
    <Style Selector="Path.icon.mirrored">
      <Setter Property="RenderTransform" Value="scale(-0.75, 0.75)" />
    </Style>
    <Style Selector="Path.icon.small.mirrored">
      <Setter Property="RenderTransform" Value="scale(-0.55, 0.55)" />
    </Style>
    <!-- Unterschriften in der Optionsleiste: weiß wie Papier, gewählte in der Akzentfarbe umrandet -->
    <Style Selector="Button.sigChip">
      <Setter Property="Background" Value="White" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Button.sigChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="Button.sigChip.selected">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Border.thumb.marked">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Border.thumb.dragging">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.thumb StackPanel.thumbActions">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.thumb:pointerover StackPanel.thumbActions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Hinweise „Seite enthält …“ je Annotationsart: wie die Bearbeitungsknöpfe, aber links, immer sichtbar und in
         Akzentfarbe (bei zu geringem Kontrast in der satteren Rahmenvariante), damit sie sich von ihnen abheben -->
    <Style Selector="Border.thumbBadge Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Border.thumbBadge">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Aus einer anderen Datei eingefügte Seiten (A41): Rahmen in der Akzentfarbe um die Miniatur -->
    <Style Selector="Border.insertedFrame">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.insertedFrame.inserted">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <!-- Anmerkungsübersicht (A45): Reiter und Einträge -->
    <Style Selector="RadioButton.sideTab">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="7" Padding="4,6" Content="{TemplateBinding Content}" HorizontalContentAlignment="Center"
                            Foreground="{DynamicResource MutedTextBrush}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.sideTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="RadioButton.sideTab:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="RadioButton.sideTab:checked TextBlock.count">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.annItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.annItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.annItem.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <!-- Lesezeichen: Markierung nur für das angezeigte Kapitel, keine eigene Auswahl des Baums -->
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.annItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.bookmark.missing">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.bookmark">
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="TextBlock.kindOnly">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Button.thumbAction">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7,7,0,0" />
      <Setter Property="Padding" Value="12,6,8,6" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.accentDot">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.accentDot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Menüleiste -->
    <Border DockPanel.Dock="Top" Classes="bar" Padding="8,2">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,6,0" VerticalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#6366F1" Offset="0" />
              <GradientStop Color="#EC4899" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="PU" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="PDF Utopia" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Menu>
          <MenuItem Header="{loc:T Menu.File}">
            <MenuItem Header="{loc:T Menu.Open}" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
            <MenuItem Header="{loc:T Menu.SaveAs}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
            <Separator />
            <MenuItem Header="{loc:T Menu.Extract}" Command="{Binding ExtractCommand}" InputGesture="Ctrl+E" />
            <MenuItem Header="{loc:T Menu.InsertPages}" Command="{Binding InsertPagesCommand}" InputGesture="Ctrl+I" />
            <MenuItem Header="{loc:T Menu.Print}" Command="{Binding PrintCommand}" InputGesture="Ctrl+P" />
            <Separator />
            <MenuItem Header="{loc:T Menu.CloseDocument}" Command="{Binding CloseDocumentCommand}" InputGesture="Ctrl+W" />
            <MenuItem Header="{loc:T Menu.Exit}" Click="OnExitClick" />
          </MenuItem>
          <MenuItem Header="{loc:T Menu.Edit}">
            <MenuItem Header="{loc:T Menu.Undo}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
            <MenuItem Header="{loc:T Menu.Redo}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
            <Separator />
            <MenuItem Header="{loc:T Menu.RotatePage}" Command="{Binding RotateCurrentPageClockwiseCommand}" />
            <MenuItem Header="{loc:T Menu.RotatePageCounterclockwise}" Command="{Binding RotateCurrentPageCounterclockwiseCommand}" />
            <MenuItem Header="{loc:T Menu.DeletePage}" Command="{Binding DeleteCurrentPageCommand}" />
            <MenuItem Header="{loc:T Menu.InsertBlankPage}" Command="{Binding InsertBlankPageCommand}" InputGesture="Ctrl+Shift+N" />
            <Separator />
            <MenuItem Header="{loc:T Menu.Find}" Click="OnFindClick" InputGesture="Ctrl+F" />
            <MenuItem Header="{loc:T Menu.Settings}" Command="{Binding OpenSettingsCommand}" />
          </MenuItem>
          <MenuItem Header="{loc:T Menu.View}">
            <MenuItem Header="{loc:T Menu.ThemeSystem}" ToggleType="Radio" GroupName="theme"
                      IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=System}"
                      Command="{Binding SetThemeCommand}" CommandParameter="{x:Static settings:ThemePreference.System}" />
            <MenuItem Header="{loc:T Menu.ThemeLight}" ToggleType="Radio" GroupName="theme"
                      IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Light}"
                      Command="{Binding SetThemeCommand}" CommandParameter="{x:Static settings:ThemePreference.Light}" />
            <MenuItem Header="{loc:T Menu.ThemeDark}" ToggleType="Radio" GroupName="theme"
                      IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}"
                      Command="{Binding SetThemeCommand}" CommandParameter="{x:Static settings:ThemePreference.Dark}" />
            <MenuItem Header="{loc:T Menu.Accent}" Click="OnAccentMenuClick" />
            <Separator />
            <MenuItem Header="{loc:T Menu.ZoomIn}" Command="{Binding ZoomInCommand}" InputGesture="Ctrl+OemPlus" />
            <MenuItem Header="{loc:T Menu.ZoomOut}" Command="{Binding ZoomOutCommand}" InputGesture="Ctrl+OemMinus" />
          </MenuItem>
          <MenuItem Header="{loc:T Menu.Language}">
            <MenuItem Header="Deutsch" ToggleType="Radio" GroupName="language"
                      IsChecked="{Binding Language, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=German}"
                      Command="{Binding SetLanguageCommand}" CommandParameter="{x:Static settings:UiLanguage.German}" />
            <MenuItem Header="English" ToggleType="Radio" GroupName="language"
                      IsChecked="{Binding Language, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=English}"
                      Command="{Binding SetLanguageCommand}" CommandParameter="{x:Static settings:UiLanguage.English}" />
          </MenuItem>
        </Menu>
      </StackPanel>
    </Border>

    <!-- Werkzeugleiste -->
    <Border DockPanel.Dock="Top" Classes="bar" Padding="8,6">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Bei schmalen Fenstern bricht die Leiste in eine zweite Zeile um, statt Schaltflächen abzuschneiden -->
        <WrapPanel Orientation="Horizontal" ItemSpacing="2" LineSpacing="4">
            <Button Classes="tb" Command="{Binding OpenCommand}"><StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconOpen}" /><TextBlock Text="{loc:T Toolbar.Open}" /></StackPanel></Button>
            <Button Classes="tb" Command="{Binding SaveAsCommand}"><StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconSave}" /><TextBlock Text="{loc:T Toolbar.SaveAs}" /></StackPanel></Button>
            <Button Classes="tb" Command="{Binding PrintCommand}"><StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconPrint}" /><TextBlock Text="{loc:T Toolbar.Print}" /></StackPanel></Button>
            <Border Classes="divider" />
            <Button Classes="tb" Command="{Binding UndoCommand}"><StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconUndo}" /><TextBlock Text="{loc:T Toolbar.Undo}" /></StackPanel></Button>
            <Button Classes="tb" Command="{Binding RedoCommand}"><StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconRedo}" /><TextBlock Text="{loc:T Toolbar.Redo}" /></StackPanel></Button>
            <Border Classes="divider" />
            <RadioButton Classes="tb" GroupName="tools" IsChecked="{Binding ToolOptions.Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Select}">
              <StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconSelect}" /><TextBlock Text="{loc:T Tool.Select}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="tb" GroupName="tools" IsChecked="{Binding ToolOptions.Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Comment}">
              <StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconComment}" /><TextBlock Text="{loc:T Tool.Comment}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="tb" GroupName="tools" IsChecked="{Binding ToolOptions.Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Marker}">
              <StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconMarker}" /><TextBlock Text="{loc:T Tool.Marker}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="tb" GroupName="tools" IsChecked="{Binding ToolOptions.Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Freehand}">
              <StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconPen}" /><TextBlock Text="{loc:T Tool.Freehand}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="tb" GroupName="tools" IsChecked="{Binding ToolOptions.Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Shape}">
              <StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconShapes}" /><TextBlock Text="{loc:T Tool.Shape}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="tb" GroupName="tools" IsChecked="{Binding ToolOptions.Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Text}">
              <StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconText}" /><TextBlock Text="{loc:T Tool.Text}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="tb" GroupName="tools" IsChecked="{Binding ToolOptions.Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Signature}">
              <StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconSignature}" /><TextBlock Text="{loc:T Tool.Signature}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="tb" GroupName="tools" IsChecked="{Binding ToolOptions.Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Eraser}">
              <StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconEraser}" /><TextBlock Text="{loc:T Tool.Eraser}" /></StackPanel>
            </RadioButton>
            <Border Classes="divider" />
            <Button Classes="tb" Command="{Binding ExtractCommand}"><StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconExtract}" /><TextBlock Text="{loc:T Toolbar.Extract}" /></StackPanel></Button>
            <Button Classes="tb" Command="{Binding InsertPagesCommand}"><StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconInsertPages}" /><TextBlock Text="{loc:T Toolbar.InsertPages}" /></StackPanel></Button>
            <Button Classes="tb" Command="{Binding RotateCurrentPageCommand}" ToolTip.Tip="{loc:T Toolbar.RotateTip}"><StackPanel Spacing="2"><Path Classes="icon" Classes.mirrored="{Binding ReverseRotation}" Data="{StaticResource IconRotate}" /><TextBlock Text="{loc:T Toolbar.Rotate}" /></StackPanel></Button>
            <Button Classes="tb" Command="{Binding DeleteCurrentPageCommand}"><StackPanel Spacing="2"><Path Classes="icon" Data="{StaticResource IconTrash}" /><TextBlock Text="{loc:T Toolbar.Delete}" /></StackPanel></Button>
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="8,6,0,0">
          <TextBox x:Name="SearchBox" Width="200" Text="{Binding SearchText}" PlaceholderText="{loc:T Toolbar.SearchPlaceholder}" VerticalAlignment="Center">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding NextSearchHitCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
            </TextBox.KeyBindings>
            <TextBox.InnerRightContent>
              <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding SearchHitsText}" Classes="hint" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Width="20" Height="20" Padding="0" Margin="0,0,4,0" CornerRadius="10" Background="Transparent" BorderThickness="0"
                        IsVisible="{Binding HasSearchText}" ToolTip.Tip="{loc:T Toolbar.ClearSearch}" Command="{Binding ClearSearchCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                  <Path Classes="icon small" Data="{StaticResource IconClose}" />
                </Button>
              </StackPanel>
            </TextBox.InnerRightContent>
          </TextBox>
          <Button x:Name="AccentButton" Classes="accentDot" ToolTip.Tip="{loc:T Toolbar.Accent}"
                  Command="{Binding PrepareColorPickerCommand}" CommandParameter="{x:Static vm:ColorTarget.Accent}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <views:ColorPickerView DataContext="{Binding ColorPicker}" />
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Werkzeugoptionen -->
    <Border DockPanel.Dock="Top" Classes="bar" Background="{DynamicResource Surface2Brush}" Padding="12,6" MinHeight="40">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" DataContext="{Binding ToolOptions}" x:DataType="vm:ToolOptionsViewModel">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowColorPicker}" VerticalAlignment="Center">
            <TextBlock Text="{loc:T Options.Color}" Classes="hint" VerticalAlignment="Center" />
            <Button Width="24" Height="24" CornerRadius="12" Padding="0" BorderThickness="2" BorderBrush="{DynamicResource SurfaceBrush}"
                    Background="{Binding CurrentColor, Converter={StaticResource HexToBrush}}" ToolTip.Tip="{Binding CurrentColor}"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PrepareColorPickerCommand}" CommandParameter="{Binding ColorTarget}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <views:ColorPickerView DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColorPicker}" />
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowMarkerColors}" VerticalAlignment="Center">
            <TextBlock Text="{loc:T Options.Color}" Classes="hint" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding MarkerColors}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Width="22" Height="22" CornerRadius="11" Padding="0" BorderThickness="2" BorderBrush="{DynamicResource SurfaceBrush}"
                          Background="{Binding Converter={StaticResource HexToBrush}}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetMarkerColorCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowShapeKinds}" VerticalAlignment="Center">
            <TextBlock Text="{loc:T Options.Shape}" Classes="hint" VerticalAlignment="Center" Margin="0,0,4,0" />
            <RadioButton Classes="fit" GroupName="shapes" ToolTip.Tip="{loc:T Shape.Rectangle}"
                         IsChecked="{Binding Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Rectangle}">
              <Path Classes="icon" Data="{StaticResource IconRect}" />
            </RadioButton>
            <RadioButton Classes="fit" GroupName="shapes" ToolTip.Tip="{loc:T Shape.Ellipse}"
                         IsChecked="{Binding Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Ellipse}">
              <Path Classes="icon" Data="{StaticResource IconEllipse}" />
            </RadioButton>
            <RadioButton Classes="fit" GroupName="shapes" ToolTip.Tip="{loc:T Shape.Line}"
                         IsChecked="{Binding Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Line}">
              <Path Classes="icon" Data="{StaticResource IconLine}" />
            </RadioButton>
            <RadioButton Classes="fit" GroupName="shapes" ToolTip.Tip="{loc:T Shape.Arrow}"
                         IsChecked="{Binding Shape, Converter={StaticResource EnumEquals}, ConverterParameter=Arrow}">
              <Path Classes="icon" Data="{StaticResource IconArrow}" />
            </RadioButton>
            <RadioButton Classes="fit" GroupName="shapes" ToolTip.Tip="{loc:T Shape.ClosedArrow}"
                         IsChecked="{Binding Shape, Converter={StaticResource EnumEquals}, ConverterParameter=ClosedArrow}">
              <Path Classes="icon" Data="{StaticResource IconClosedArrow}" />
            </RadioButton>
          </StackPanel>
          <!-- Unterschrift (A49, Mockup v5): gespeicherte Unterschriften als Vorschau, „+ Neue“, „Verwalten…“ -->
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowSignatureOptions}" VerticalAlignment="Center">
            <TextBlock Text="{loc:T Signature.None}" IsVisible="{Binding HasNoSignature}" Classes="hint" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Signatures}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SignatureChoice">
                  <Button Classes="sigChip" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Signature.Name}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSignatureCommand}" CommandParameter="{Binding}">
                    <controls:SignaturePreview Signature="{Binding Signature}" Width="76" Height="24" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{loc:T Signature.New}" IsVisible="{Binding CanAddSignature}" VerticalAlignment="Center"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NewSignatureCommand}" />
            <Button Content="{loc:T Signature.Manage}" VerticalAlignment="Center"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ManageSignaturesCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowArrowEnds}" VerticalAlignment="Center">
            <TextBlock Text="{loc:T Options.ArrowEnds}" Classes="hint" VerticalAlignment="Center" Margin="0,0,4,0" />
            <RadioButton Classes="fit" GroupName="arrowEnds" ToolTip.Tip="{loc:T ArrowEnds.End}"
                         IsChecked="{Binding ArrowEnds, Converter={StaticResource EnumEquals}, ConverterParameter=End}">
              <Path Classes="icon" Data="{StaticResource IconArrowEnd}" />
            </RadioButton>
            <RadioButton Classes="fit" GroupName="arrowEnds" ToolTip.Tip="{loc:T ArrowEnds.Start}"
                         IsChecked="{Binding ArrowEnds, Converter={StaticResource EnumEquals}, ConverterParameter=Start}">
              <Path Classes="icon" Data="{StaticResource IconArrowStart}" />
            </RadioButton>
            <RadioButton Classes="fit" GroupName="arrowEnds" ToolTip.Tip="{loc:T ArrowEnds.Both}"
                         IsChecked="{Binding ArrowEnds, Converter={StaticResource EnumEquals}, ConverterParameter=Both}">
              <Path Classes="icon" Data="{StaticResource IconArrowBoth}" />
            </RadioButton>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowWidth}" VerticalAlignment="Center">
            <TextBlock Text="{Binding WidthLabel}" Classes="hint" VerticalAlignment="Center" />
            <Slider Width="120" Minimum="{Binding WidthMinimum}" Maximum="{Binding WidthMaximum}" Value="{Binding CurrentWidth}"
                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <TextBlock Text="{Binding WidthText}" MinWidth="36" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowFreehandOptions}" VerticalAlignment="Center">
            <TextBlock Text="{loc:T Options.Smoothing}" Classes="hint" VerticalAlignment="Center" />
            <Slider Width="120" Minimum="0" Maximum="100" Value="{Binding Smoothing}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Smoothing, StringFormat='{}{0} %'}" MinWidth="40" VerticalAlignment="Center" />
            <CheckBox Content="{loc:T Options.Pressure}" IsChecked="{Binding PressureSensitive}" VerticalAlignment="Center" />
          </StackPanel>
          <Border IsVisible="{Binding ShowPressureHint}" Background="{DynamicResource WarnBackgroundBrush}" CornerRadius="6" Padding="9,3" VerticalAlignment="Center">
            <TextBlock Text="{loc:T Options.NoPressure}" Foreground="{DynamicResource WarnTextBrush}" FontSize="12" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowEraserOptions}" VerticalAlignment="Center">
            <TextBlock Text="{loc:T Options.EraserSize}" Classes="hint" VerticalAlignment="Center" />
            <Slider Width="120" Minimum="2" Maximum="40" Value="{Binding EraserRadius}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            <TextBlock Text="{Binding EraserRadius, StringFormat='{}{0:0} px'}" MinWidth="36" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ToolOptions.Hint}" Classes="hint" FontStyle="Italic" HorizontalAlignment="Right"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
      </Grid>
    </Border>

    <!-- Statusleiste -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="hint" Text="{Binding PageStatus}" />
          <TextBlock Classes="hint" Text="{Binding ActiveDocument.SelectionStatus, FallbackValue=''}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="hint" Margin="18,0,0,0" Text="{Binding UndoStatus}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0" IsVisible="{Binding HasDocument}">
          <TextBlock Classes="hint" Text="{Binding ActiveDocument.FileName, FallbackValue=''}" />
          <TextBlock Classes="hint" Text=" · " />
          <TextBlock Classes="hint" Text="{Binding ActiveDocument.FileSizeText, FallbackValue=''}" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
          <!-- Ansichten: werden auch beim Maximieren und jeder Größenänderung neu angewandt (A33) -->
          <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,12,0" IsEnabled="{Binding HasDocument}">
            <RadioButton Classes="fit" GroupName="fit" IsChecked="{Binding FitMode, Converter={StaticResource EnumEquals}, ConverterParameter=Height}">
              <StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="icon small" Data="{StaticResource IconFitHeight}" /><TextBlock Text="{loc:T Status.FitHeight}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="fit" GroupName="fit" IsChecked="{Binding FitMode, Converter={StaticResource EnumEquals}, ConverterParameter=Width}">
              <StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="icon small" Data="{StaticResource IconFitWidth}" /><TextBlock Text="{loc:T Status.FitWidth}" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="fit" GroupName="fit" IsChecked="{Binding FitMode, Converter={StaticResource EnumEquals}, ConverterParameter=Page}">
              <StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="icon small" Data="{StaticResource IconFitPage}" /><TextBlock Text="{loc:T Status.FitPage}" /></StackPanel>
            </RadioButton>
          </StackPanel>
          <Button Width="22" Height="22" Padding="0" Command="{Binding ZoomOutCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{loc:T Toolbar.ZoomOut}">
            <Path Classes="icon small" Data="{StaticResource IconMinus}" />
          </Button>
          <!-- Zoom direkt eingeben: Enter übernimmt, Esc oder Verlassen des Felds stellt den aktuellen Wert wieder her -->
          <TextBox x:Name="ZoomBox" Classes="zoomInput" Text="{Binding ZoomInput}" Width="62" MinHeight="22" Padding="4,1" FontSize="12"
                   TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{loc:T Status.ZoomInput}"
                   LostFocus="OnZoomBoxLostFocus">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ApplyZoomInputCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding ResetZoomInputCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Width="22" Height="22" Padding="0" Command="{Binding ZoomInCommand}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{loc:T Toolbar.ZoomIn}">
            <Path Classes="icon small" Data="{StaticResource IconPlus}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Dokument-Tabs -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
            Padding="8,6,8,0" IsVisible="{Binding HasDocument}">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <ItemsControl ItemsSource="{Binding Documents}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DocumentViewModel">
              <Button Classes="tab" Classes.active="{Binding IsActive}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActivateTabCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon small" Data="{StaticResource IconLock}" IsVisible="{Binding IsProtected}" />
                  <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center" />
                  <Button Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}">
                    <Path Classes="icon small" Data="{StaticResource IconClose}" />
                  </Button>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="tab" Command="{Binding OpenCommand}">
          <Path Classes="icon small" Data="{StaticResource IconPlus}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Hauptbereich -->
    <Grid>
      <Grid x:Name="MainArea" IsVisible="{Binding HasDocument}">
        <!-- Linke Leiste in der Breite veränderbar (F30) -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" MinWidth="180" MaxWidth="420" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0"
                SizeChanged="OnSidebarSizeChanged">
          <DockPanel>
            <!-- Ohne Anmerkungen und Lesezeichen: schlichte Überschrift der Seitenliste -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10"
                    IsVisible="{Binding !ShowSidebarTabs}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:T Pages.Title}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Classes="hint" Text="{Binding ActiveDocument.Thumbnails.Count, FallbackValue=''}" />
              </Grid>
            </Border>
            <!-- Reiter nur für vorhandene Inhalte (A45, A46); passen sie nicht nebeneinander, rückt der dritte nach unten (F30) -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8"
                    IsVisible="{Binding ShowSidebarTabs}">
              <controls:TabStripPanel>
                <RadioButton Classes="sideTab" GroupName="side" IsChecked="{Binding SidebarView, Converter={StaticResource EnumEquals}, ConverterParameter=Pages}">
                  <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:T Pages.Title}" FontWeight="SemiBold" />
                    <TextBlock Classes="hint count" Text="{Binding ActiveDocument.Thumbnails.Count, FallbackValue=''}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="sideTab" GroupName="side" IsVisible="{Binding ActiveDocument.AnnotationList.HasAny, FallbackValue=False}"
                             IsChecked="{Binding SidebarView, Converter={StaticResource EnumEquals}, ConverterParameter=Annotations}">
                  <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:T Annotations.Title}" FontWeight="SemiBold" />
                    <TextBlock Classes="hint count" Text="{Binding ActiveDocument.AnnotationList.Count, FallbackValue=''}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="sideTab" GroupName="side" IsVisible="{Binding ActiveDocument.BookmarkList.HasAny, FallbackValue=False}"
                             IsChecked="{Binding SidebarView, Converter={StaticResource EnumEquals}, ConverterParameter=Bookmarks}">
                  <TextBlock Text="{loc:T Bookmarks.Title}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </RadioButton>
              </controls:TabStripPanel>
            </Border>
            <Panel>
            <!-- Lesezeichen (A46) -->
            <TreeView IsVisible="{Binding SidebarView, Converter={StaticResource EnumEquals}, ConverterParameter=Bookmarks}"
                      ItemsSource="{Binding ActiveDocument.BookmarkList.Items, FallbackValue={x:Null}}" Margin="4,4,4,12">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:BookmarkItemViewModel">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="MinHeight" Value="28" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:BookmarkItemViewModel" ItemsSource="{Binding Children}">
                  <Button Classes="annItem bookmark" Classes.selected="{Binding IsCurrent}" Classes.missing="{Binding IsTargetMissing}"
                          IsEnabled="{Binding CanShow}" ToolTip.Tip="{Binding ToolTip}" ToolTip.ShowOnDisabled="True"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowBookmarkCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" />
                  </Button>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <Panel IsVisible="{Binding SidebarView, Converter={StaticResource EnumEquals}, ConverterParameter=Annotations}">
            <DockPanel DataContext="{Binding ActiveDocument.AnnotationList, FallbackValue={x:Null}}" x:DataType="vm:AnnotationListViewModel">
              <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnnotationFilterOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Border>
              <Panel>
                <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Classes="hint" TextWrapping="Wrap" TextAlignment="Center" Margin="16,24" />
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding Items}" Margin="6,2,6,12">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AnnotationListItem">
                        <Panel>
                          <TextBlock Text="{Binding HeaderText}" IsVisible="{Binding IsHeader}" Classes="hint" FontSize="11" FontWeight="SemiBold" Margin="8,10,8,4" />
                          <Button Classes="annItem" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsEntry}"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowAnnotationCommand}" CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                              <Border Classes="thumbBadge" Width="22" Height="22" VerticalAlignment="Top">
                                <Panel>
                                  <Path Classes="icon small" Data="{StaticResource IconComment}" IsVisible="{Binding IsComment}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <Path Classes="icon small" Data="{StaticResource IconMarker}" IsVisible="{Binding IsHighlight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <Path Classes="icon small" Data="{StaticResource IconPen}" IsVisible="{Binding IsFreehand}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <Path Classes="icon small" Data="{StaticResource IconShapes}" IsVisible="{Binding IsShape}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <Path Classes="icon small" Data="{StaticResource IconText}" IsVisible="{Binding IsText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                              </Border>
                              <Ellipse Grid.Column="1" Width="9" Height="9" Margin="0,7,0,0" VerticalAlignment="Top"
                                       Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Stroke="#26000000" StrokeThickness="1" />
                              <TextBlock Grid.Column="2" Classes.kindOnly="{Binding IsKindOnly}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0">
                                <Run Text="{Binding NumberPrefix}" FontWeight="Bold" /><Run Text="{Binding Description}" />
                              </TextBlock>
                            </Grid>
                          </Button>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>
            </DockPanel>
            </Panel>
            <ScrollViewer x:Name="PageListScroller" Focusable="True" IsVisible="{Binding SidebarView, Converter={StaticResource EnumEquals}, ConverterParameter=Pages}">
              <ScrollViewer.KeyBindings>
                <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllPagesCommand}" />
                <KeyBinding Gesture="Escape" Command="{Binding ClearPageSelectionCommand}" />
                <KeyBinding Gesture="Delete" Command="{Binding DeleteCurrentPageCommand}" />
              </ScrollViewer.KeyBindings>
              <Panel>
                <ItemsControl x:Name="ThumbnailList" ItemsSource="{Binding ActiveDocument.Thumbnails, FallbackValue={x:Null}}" Margin="12">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageThumbnailViewModel">
                      <Border Classes="thumb" Classes.selected="{Binding IsSelected}" Classes.marked="{Binding IsMarked}">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{loc:T Pages.Rotate}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RotatePageClockwiseCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="{loc:T Pages.RotateCounterclockwise}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RotatePageCounterclockwiseCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="{loc:T Pages.Delete}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeletePageCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="{loc:T Pages.Extract}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExtractPageCommand}" CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="{loc:T Pages.InsertBlankAfter}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InsertBlankPageAfterCommand}" CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Panel>
                          <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <Border Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ThumbnailBoxWidth}"
                                    Height="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ThumbnailBoxHeight}">
                              <Border Classes="insertedFrame" Classes.inserted="{Binding IsInserted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                     MaxWidth="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ThumbnailImageMaxWidth}"
                                     MaxHeight="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ThumbnailImageMaxHeight}">
                                <Image.Effect><DropShadowEffect BlurRadius="4" OffsetX="0" OffsetY="1" Opacity="0.3" /></Image.Effect>
                              </Image>
                              </Border>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                              <TextBlock Text="{Binding Label}" Classes="hint" />
                              <TextBlock Text="{Binding OriginalHint}" Classes="hint" Opacity="0.7" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0">
                            <Border Classes="thumbBadge" IsVisible="{Binding HasComments}" ToolTip.Tip="{loc:T Pages.HasComments}">
                              <Path Classes="icon small" Data="{StaticResource IconComment}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Classes="thumbBadge" IsVisible="{Binding HasHighlights}" ToolTip.Tip="{loc:T Pages.HasHighlights}">
                              <Path Classes="icon small" Data="{StaticResource IconMarker}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Classes="thumbBadge" IsVisible="{Binding HasInk}" ToolTip.Tip="{loc:T Pages.HasInk}">
                              <Path Classes="icon small" Data="{StaticResource IconPen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Classes="thumbBadge" IsVisible="{Binding HasShapes}" ToolTip.Tip="{loc:T Pages.HasShapes}">
                              <Path Classes="icon small" Data="{StaticResource IconShapes}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Classes="thumbBadge" IsVisible="{Binding HasText}" ToolTip.Tip="{loc:T Pages.HasText}">
                              <Path Classes="icon small" Data="{StaticResource IconText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </StackPanel>
                          <StackPanel Classes="thumbActions" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
                            <Button Classes="thumbAction" ToolTip.Tip="{loc:T Toolbar.RotateTip}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RotatePageCommand}" CommandParameter="{Binding}">
                              <Path Classes="icon small" Classes.mirrored="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ReverseRotation}"
                                    Data="{StaticResource IconRotate}" />
                            </Button>
                            <Button Classes="thumbAction" ToolTip.Tip="{loc:T Pages.Delete}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeletePageCommand}" CommandParameter="{Binding}">
                              <Path Classes="icon small" Data="{StaticResource IconTrash}" />
                            </Button>
                          </StackPanel>
                        </Panel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas x:Name="DragLayer" IsHitTestVisible="False">
                  <Border x:Name="DropLine" Height="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" IsVisible="False" />
                  <!-- Abbild der gezogenen Seite, folgt dem Mauszeiger -->
                  <Border x:Name="DragGhost" x:DataType="vm:PageThumbnailViewModel" IsVisible="False" Opacity="0.85" Padding="8" CornerRadius="8"
                          Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="2"
                          BoxShadow="0 6 18 0 #40000000">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                      <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                             MaxWidth="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ThumbnailImageMaxWidth}"
                             MaxHeight="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ThumbnailImageMaxHeight}" />
                      <TextBlock Text="{Binding Label}" Classes="hint" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Canvas>
              </Panel>
            </ScrollViewer>
            </Panel>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" Background="Transparent" ResizeDirection="Columns" DragCompleted="OnSidebarResized"
                      ToolTip.Tip="{loc:T Sidebar.Resize}" />
        <ScrollViewer x:Name="PageScroller" Grid.Column="2" Background="{DynamicResource CanvasBrush}" HorizontalScrollBarVisibility="Auto">
          <LayoutTransformControl x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="32">
            <Border BoxShadow="0 1 3 0 #30000000, 0 8 24 0 #20000000">
              <StackPanel>
                <controls:PageEditor Document="{Binding ActiveDocument}" Options="{Binding ToolOptions}" Zoom="{Binding Zoom}" />
                <!-- Fußnoten auf der verlängerten Seite -->
                <Border Background="#FCFCFD" BorderBrush="#C9CDD8" BorderThickness="0,2,0,0" Padding="40,12,40,18"
                        IsVisible="{Binding ActiveDocument.HasFootnotes, FallbackValue=False}">
                  <!-- Fußnoten stehen auf der (weißen) Seite: feste Papierfarben in jedem Theme und Zustand -->
                  <Border.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F1F2F5" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#EEF0FF" />
                    <SolidColorBrush x:Key="TextControlForeground" Color="#333333" />
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#333333" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1D2330" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#C7CEEA" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A8F99" />
                  </Border.Resources>
                  <StackPanel Spacing="6">
                    <TextBlock Text="{loc:T Footnotes.Heading}" FontSize="9" FontWeight="SemiBold" Foreground="#9AA0AB" LetterSpacing="0.6" />
                    <ItemsControl ItemsSource="{Binding ActiveDocument.Footnotes, FallbackValue={x:Null}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FootnoteViewModel">
                          <Grid ColumnDefinitions="22,*" Margin="0,0,0,4">
                            <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Top" Margin="0,3,0,0"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                    BorderBrush="{Binding BorderHex, Converter={StaticResource HexToBrush}}" BorderThickness="1">
                              <TextBlock Text="{Binding Number}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{Binding NumberForegroundHex, Converter={StaticResource HexToBrush}}" />
                            </Border>
                            <TextBox Grid.Column="1" Classes="paper" Text="{Binding Text}" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12"
                                     BorderThickness="0" Padding="2" MinHeight="0" CaretBrush="#1D2330"
                                     LostFocus="OnFootnoteLostFocus" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </LayoutTransformControl>
        </ScrollViewer>
      </Grid>

      <!-- Startansicht -->
      <StackPanel IsVisible="{Binding NoDocument}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <Path Classes="icon" Data="{StaticResource IconOpen}" Width="48" Height="48" Margin="0" Stretch="Uniform" RenderTransform="none" Stroke="{DynamicResource MutedTextBrush}" />
        <TextBlock Text="{loc:T Empty.Title}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:T Empty.Hint}" Classes="hint" HorizontalAlignment="Center" />
        <Button Classes="accent" Content="{loc:T Toolbar.Open}" HorizontalAlignment="Center" Command="{Binding OpenCommand}" Margin="0,6,0,0" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
